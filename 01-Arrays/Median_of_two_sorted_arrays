import java.util.Arrays;
class Solution {
    public double findMedianSortedArrays(int[] nums1, int[] nums2) {
        int i,j;
        int m,n;
        double median;
        m=nums1.length;
        n=nums2.length;
        int len= m+n;
        int[] merged =new int [m+n];
        System.arraycopy(nums1,0,merged,0,m);
        System.arraycopy(nums2,0,merged,m,n);
        Arrays.sort(merged);
        if((m+n)%2!=0)
            median=(int)merged[(m+n)/2];
        else
            median=(double)(merged[len/2-1]+merged[len/2])/2.0;
    



    return median;
    }
}
